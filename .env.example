# =====================================================================
# AI STOCK RADAR – Environment Variables
# Copy to .env.local and fill in. NEVER commit real keys.
# All provider calls run server-side; keys are never sent to the browser.
# =====================================================================

# ---------------------------------------------------------------------
# 1) Kursdaten, Volumen, Historie, Indizes, Nachrichten-Feed
#    Yahoo Finance (öffentliche Chart-/Search-Endpunkte)
#    -> KEIN API-Key nötig, kostenlos, Kurse verzögert (US i.d.R. bis 15 Min.,
#       EU 15–20 Min.). Inoffizielle Endpunkte: Verfügbarkeit nicht garantiert.
#    Nichts zu konfigurieren.
# ---------------------------------------------------------------------

# ---------------------------------------------------------------------
# 2) Finnhub – EMPFOHLEN (kostenloser Key: https://finnhub.io/register)
#    Free Tier (60 Aufrufe/Minute) liefert:
#      - Analystenempfehlungen + Revisionen      (Komponente "Analystenrevisionen")
#      - Kennzahlen: Umsatz-/EPS-Wachstum, Margen (Komponente "Fundamentale Entwicklung")
#      - Earnings-Überraschungen + Earnings-Kalender
#      - Company News (zusätzlich zu Yahoo)
#      - Echtzeit-Kurse für US-Titel in der Detailanalyse
#    Ohne Key: diese Komponenten werden als "nicht verfügbar" markiert und ihr
#    Gewicht wird umverteilt (Datenabdeckung ~75 %). Es werden KEINE Werte erfunden.
#    Nicht im Free Tier (kostenpflichtige Finnhub-Pakete): institutionelle
#    Eigentümer/13F, Upgrade/Downgrade-Historie, Kursziele, EPS-Schätzungsrevisionen,
#    Fundamentaldaten für Nicht-US-Listings (z. B. Siemens).
# ---------------------------------------------------------------------
FINNHUB_API_KEY=

# ---------------------------------------------------------------------
# 3) Upstash Redis – OPTIONAL, empfohlen für Produktion (kostenloser Plan reicht)
#    Geteilter Cache über alle Serverless-Instanzen (schont API-Limits) und
#    persistente Signalhistorie ("Erkannt am"). Ohne Redis: In-Memory-Cache,
#    Signalhistorie geht bei Neustart verloren.
#    Beide Namenskonventionen werden unterstützt (Upstash bzw. Vercel KV).
# ---------------------------------------------------------------------
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
# KV_REST_API_URL=
# KV_REST_API_TOKEN=

# ---------------------------------------------------------------------
# 4) Engine-Konfiguration – OPTIONAL
# ---------------------------------------------------------------------
# Serverseitige Standardgewichtung (für Erkennungszeitpunkte/Signalhistorie).
# Im UI (CFG) kann jeder Nutzer zusätzlich eine eigene Gewichtung setzen.
# RADAR_WEIGHTS={"volume":20,"relativeStrength":15,"momentum":15,"news":15,"fundamentals":15,"analysts":10,"marketSector":10}

# Größe des automatisch gescannten Aktien-Universums:
#   medium (Standard, ~130 Titel): alle DAX-40- und Euro-Stoxx-50-Werte + je Branche die
#          4 meistgehandelten US-Aktien + 20 Kern-Titel – kompletter Durchlauf ca. 3 Min.
#   large  (~570 Titel): alle Werte aus S&P 500, Nasdaq-100, DAX 40, Euro Stoxx 50 – ca. 14 Min.
#   core   (20 Titel): nur die Kern-Titel
# RADAR_UNIVERSE=medium

# Universum erweitern ohne Codeänderung (JSON-Array). yahoo = Symbol für Kursdaten,
# finnhub = US-Symbol/ADR für Fundamentaldaten (null wenn nicht abgedeckt).
# RADAR_EXTRA_UNIVERSE=[{"ticker":"CRM","name":"Salesforce","yahoo":"CRM","finnhub":"CRM","sector":"Software","region":"US","benchmark":"SPY","sectorEtf":"IGV","isin":"US79466L3024"}]

# Debug: protokolliert jeden Provider-Aufruf mit Dauer (ohne Keys)
# RADAR_DEBUG=1

# Nur in Umgebungen mit HTTPS-Proxy nötig (Node fetch nutzt HTTPS_PROXY sonst nicht):
# NODE_USE_ENV_PROXY=1
